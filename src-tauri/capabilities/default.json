{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "CorpusMind Voice default capabilities: core window access plus sidecar process spawn for the embedded Next.js server.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "shell:allow-spawn",
    "shell:allow-stdin-write"
  ]
}
