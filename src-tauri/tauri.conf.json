{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CorpusMind Voice",
  "version": "1.0.0",
  "identifier": "org.waleedmandour.corpusmind.voice",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../public-splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CorpusMind Voice",
        "width": 1360,
        "height": 860,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#071022"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Science",
    "shortDescription": "Offline audio → linguistically annotated corpus",
    "longDescription": "CorpusMind Voice turns MP3/MP4/WAV or microphone input into a linguistically annotated corpus (ASR, forced alignment, prosody, disfluency) fully offline. A companion tool for CorpusMind.",
    "publisher": "Dr. Waleed Mandour",
    "copyright": "MIT License © 2026 Dr. Waleed Mandour",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../.next/standalone/": "standalone/",
      "../db/seed.db": "seed.db"
    },
    "externalBin": ["binaries/node"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "languages": ["English", "Arabic"], "displayLanguageSelector": true }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0"] }
    }
  },
  "plugins": {}
}
